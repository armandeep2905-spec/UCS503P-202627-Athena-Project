# Copy this file to .env for local development. On Render, set these as
# actual environment variables in the dashboard instead of uploading .env.

SECRET_KEY=change-this-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---------------------------------------------------------
# Option A: single URL (what Render gives you when you link a Postgres
# instance). If set, this takes priority over the DB_* vars below.
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Option B: discrete vars, matching DataBase/create_database.py's existing
# .env pattern. Used if DATABASE_URL is not set.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=athena
DB_USER=athena
DB_PASSWORD=athena

# --- CORS ---------------------------------------------------------------
# Comma-separated list of frontend origins allowed to call this API.
CORS_ALLOWED_ORIGINS=http://localhost:5173
